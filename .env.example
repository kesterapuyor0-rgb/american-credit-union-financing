# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Resend credentials used for account security emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="American Credit Union <notifications@americancreditunionfinancing.app>"
SUPPORT_EMAIL="americancreditunion.financing@gmail.com"
# Public frontend support contact; keep in sync with SUPPORT_EMAIL.
VITE_SUPPORT_EMAIL="americancreditunion.financing@gmail.com"
NEXT_PUBLIC_APP_URL="https://credit-union-financing.vercel.app"

# WebAuthn relying-party configuration. Use the exact trusted browser origin and its domain.
# Production defaults to the Vercel project URL, or american-credit-union-financing.vercel.app.
# For local development, set PASSKEY_ORIGIN=http://localhost:5173 and PASSKEY_RP_ID=localhost.
PASSKEY_RP_ID="american-credit-union-financing.vercel.app"
PASSKEY_ORIGIN="https://american-credit-union-financing.vercel.app"

# Dedicated MongoDB connection string for local development only.
# Keep this pointed at a separate local/development database; do not copy the Vercel production URI here.
LOCAL_MONGO_URI="mongodb://127.0.0.1:27017/american-credit-union-financing-local"

# MongoDB connection string used by deployed environments (including Vercel).
MONGO_URI="mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority"
MONGO_SERVER_SELECTION_TIMEOUT_MS="5000"
JWT_SECRET="replace-with-a-long-random-secret"

# Web Push VAPID credentials. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:security@example.com"

# Optional development-only offline sign-in. Keep LOCAL_DEV_AUTH=false outside local testing.
LOCAL_DEV_AUTH="false"
LOCAL_DEV_EMAIL="apuyork@gmail.com"
LOCAL_DEV_PASSWORD=""
LOCAL_DEV_ROLE="user"
LOCAL_DEV_FULL_NAME="Local Developer"
LOCAL_DEV_PHONE="Not provided"

# Optional first-admin bootstrap. Set both values for a new Atlas database.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FULL_NAME="System Administrator"
ADMIN_PHONE=""
